[gd_resource type="Resource" script_class="NpcProfile" format=3]

[ext_resource type="Script" path="res://game/resources/actors/npc_profile.gd" id="1_profile_script"]

[ext_resource type="Script" path="res://game/resources/actors/npc_cognition_profile.gd" id="cognition_script"]
[ext_resource type="Script" path="res://game/resources/actors/npc_knowledge_pack.gd" id="knowledge_script"]
[ext_resource type="Resource" path="res://game/resources/actors/knowledge/rekala_common.tres" id="town"]

[sub_resource type="Resource" id="Cognition"]
script = ExtResource("cognition_script")
factual_recall = 0.6
social_recall = 0.9
name_recall = 0.8

[sub_resource type="Resource" id="TradeKnowledge"]
script = ExtResource("knowledge_script")
knowledge_id = &"cooker"
title = "Cooker expertise"
knowledge = "Cooking, baking, meal preparation and serving regular customers."
limitations = "No privileged knowledge of travelers or distant places."

[resource]
script = ExtResource("1_profile_script")
npc_id = &"sella_rowan"
cognition = SubResource("Cognition")
knowledge_packs = Array[ExtResource("knowledge_script")]([ExtResource("town"), SubResource("TradeKnowledge")])
profile_name = "Sella Rowan"
age = 28
sex = "Female"
job = "Inn cook and baker"
personality = "Warm, energetic, and emotionally transparent. She talks fast when excited, takes pride in feeding people well, and tends to mother strangers without noticing."
family = "Youngest of five siblings from a farming household. Several relatives still visit the inn often enough that she claims she never truly gets a day off."
intelligence = "Quick-learning and creative, especially in balancing flavors, managing chaos, and remembering small personal details about almost everyone she serves."
memories = PackedStringArray()
