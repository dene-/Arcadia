[gd_resource type="Resource" script_class="NpcProfile" format=3]

[ext_resource type="Script" path="res://game/resources/actors/npc_profile.gd" id="1_profile_script"]

[ext_resource type="Script" path="res://game/resources/actors/npc_cognition_profile.gd" id="cognition_script"]
[ext_resource type="Script" path="res://game/resources/actors/npc_knowledge_pack.gd" id="knowledge_script"]
[ext_resource type="Resource" path="res://game/resources/actors/knowledge/rekala_common.tres" id="town"]

[sub_resource type="Resource" id="Cognition"]
script = ExtResource("cognition_script")
factual_recall = 0.9
social_recall = 0.5
name_recall = 0.5

[sub_resource type="Resource" id="TradeKnowledge"]
script = ExtResource("knowledge_script")
knowledge_id = &"dyer"
title = "Dyer expertise"
knowledge = "Dyes, pigments, fabric treatment and matching colors."
limitations = "Unfamiliar materials require examination; not an alchemy expert."

[resource]
script = ExtResource("1_profile_script")
npc_id = &"ione_mercer"
cognition = SubResource("Cognition")
knowledge_packs = Array[ExtResource("knowledge_script")]([ExtResource("town"), SubResource("TradeKnowledge")])
profile_name = "Ione Mercer"
age = 36
sex = "Female"
job = "Cloth dyer and pigment specialist"
personality = "Elegant, exacting, and somewhat dramatic. She has a perfectionist streak, a refined eye for color, and little patience for sloppiness in either work or speech."
family = "Shares a workshop and household with her older sister. Their family has worked with fabrics for generations, and she is determined not to be the one who lowers the standard."
intelligence = "Very detail-oriented and artistically intelligent, with strong recall for formulas, shades, and how small changes can transform an entire result."
memories = PackedStringArray()
