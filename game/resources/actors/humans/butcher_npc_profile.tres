[gd_resource type="Resource" script_class="NpcProfile" format=3]

[ext_resource type="Script" path="res://game/resources/actors/npc_profile.gd" id="1_profile_script"]

[ext_resource type="Script" path="res://game/resources/actors/npc_cognition_profile.gd" id="cognition_script"]
[ext_resource type="Script" path="res://game/resources/actors/npc_knowledge_pack.gd" id="knowledge_script"]
[ext_resource type="Resource" path="res://game/resources/actors/knowledge/rekala_common.tres" id="town"]

[sub_resource type="Resource" id="Cognition"]
script = ExtResource("cognition_script")
factual_recall = 0.6
social_recall = 0.9
name_recall = 0.8

[sub_resource type="Resource" id="TradeKnowledge"]
script = ExtResource("knowledge_script")
knowledge_id = &"butcher"
title = "Butcher expertise"
knowledge = "Preparing meat, livestock buying, ordinary prices and local trading habits."
limitations = "No knowledge of private affairs unless personally told."

[resource]
script = ExtResource("1_profile_script")
npc_id = &"bram_edevane"
cognition = SubResource("Cognition")
knowledge_packs = Array[ExtResource("knowledge_script")]([ExtResource("town"), SubResource("TradeKnowledge")])
profile_name = "Bram Edevane"
age = 39
sex = "Male"
job = "Butcher and livestock buyer"
personality = "Loud, friendly, and unashamedly nosy. He enjoys gossip, laughs easily, and treats conversation like a shared meal that should leave everyone satisfied."
family = "Lives with his older mother and a younger brother who handles deliveries. He often talks about his family as if the whole town already knows them personally."
intelligence = "Clever in social situations, quick with mental arithmetic, and very good at reading people, even if he hides it behind jokes."
memories = PackedStringArray()
