[gd_resource type="Resource" script_class="NpcProfile" format=3]

[ext_resource type="Script" path="res://game/resources/actors/npc_profile.gd" id="1_profile_script"]

[ext_resource type="Script" path="res://game/resources/actors/npc_cognition_profile.gd" id="cognition_script"]
[ext_resource type="Script" path="res://game/resources/actors/npc_knowledge_pack.gd" id="knowledge_script"]
[ext_resource type="Resource" path="res://game/resources/actors/knowledge/rekala_common.tres" id="town"]

[sub_resource type="Resource" id="Cognition"]
script = ExtResource("cognition_script")
factual_recall = 0.85
social_recall = 0.6
name_recall = 0.6

[sub_resource type="Resource" id="TradeKnowledge"]
script = ExtResource("knowledge_script")
knowledge_id = &"jeweller"
title = "Jeweller expertise"
knowledge = "Gem setting, jewelry workmanship and spotting visible flaws."
limitations = "Cannot determine hidden provenance or enchantments by appearance alone."

[resource]
script = ExtResource("1_profile_script")
npc_id = &"cassian_vale"
cognition = SubResource("Cognition")
knowledge_packs = Array[ExtResource("knowledge_script")]([ExtResource("town"), SubResource("TradeKnowledge")])
profile_name = "Cassian Vale"
age = 31
sex = "Male"
job = "Jeweller and gem setter"
personality = "Charming, articulate, and a little vain. He enjoys beauty, precision, and being admired for his work, though he becomes intensely focused when craft is on the line."
family = "Comes from a once-wealthy merchant family that has seen better days. He now supports a younger sister who studies in the city and sends him long, demanding letters."
intelligence = "Refined and perceptive, with strong aesthetic judgment, nimble hands, and the kind of careful concentration that notices flaws others miss."
memories = PackedStringArray()
