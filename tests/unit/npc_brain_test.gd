extends "res://tests/test_case.gd"

const Routine = preload("res://tests/unit/npc_routine_task_test.gd")
const Safety = preload("res://tests/unit/npc_safety_task_test.gd")

func _routine(rig: Routine.Rig, activity: String, space: String, until: float) -> NpcRoutineTask:
	return NpcRoutineTask.create(Routine.routine_params(activity, space, until), rig.tuning)

func _shelter(rig: Routine.Rig, until: float, space: String = "plaza") -> NpcSafetyTask:
	return NpcSafetyTask.create(Safety.safety_params("SHELTER", until, space, [10.0, 20.0]),
		rig.tuning)

func _caution(rig: Routine.Rig, until: float) -> NpcSafetyTask:
	return NpcSafetyTask.create(Safety.safety_params("CAUTION", until), rig.tuning)

func _reloaded(source: Routine.Rig) -> Routine.Rig:
	var loaded := Routine.Rig.new()
	var data: Variant = JSON.parse_string(JSON.stringify(source.mind.to_data()))
	assert_true(loaded.mind.from_data(data), "the mind survives a JSON round trip")
	return loaded

func test_sleep_caution_shelter_then_the_routine_resumes_and_reroutes() -> void:
	var rig := Routine.Rig.new()
	rig.actor.sleeping = true
	rig.actor.world_space = &"home"
	rig.executor.bed = Vector2(8.0, 9.0)
	var routine := _routine(rig, "rest", "home", 400.0)
	assert_true(rig.start(routine, 100.0))
	assert_eq(rig.phase(), "sleep")
	assert_true(rig.executor.begun.is_empty())
	var caution := _caution(rig, 150.0)
	assert_true(rig.start(caution, 110.0))
	assert_eq(rig.brain.task_state(routine.task_id), "SUSPENDED")
	assert_true(rig.actor.sleeping, "a noise alone does not wake the sleeper")
	assert_true(rig.executor.begun.is_empty(), "caution never travels")
	rig.actor.alert_response.alert_active = true
	var shelter := _shelter(rig, 200.0)
	assert_true(rig.start(shelter, 120.0))
	assert_eq(rig.last_finished()["task_id"], caution.task_id)
	assert_eq(rig.brain.task_state(routine.task_id), "SUSPENDED")
	assert_eq(rig.phase(), "orient")
	assert_true(rig.actor.sleeping)
	rig.tick(121.0)
	assert_true(rig.actor.sleeping, "still orienting")
	rig.actor.alert_response.alert_active = false
	rig.tick(122.0)
	assert_false(rig.actor.sleeping)
	assert_eq(rig.phase(), "flee")
	assert_eq(rig.executor.spaces(), [&"plaza"] as Array[StringName], "only the refuge is ever a destination")
	rig.executor.arrive()
	rig.tick(130.0)
	assert_eq(rig.phase(), "shelter")
	rig.tick(199.0)
	assert_eq(rig.brain.task_state(shelter.task_id), "RUNNING")
	rig.tick(200.0)
	assert_eq(rig.last_finished()["task_id"], shelter.task_id)
	assert_eq(rig.last_finished()["status"], "COMPLETED")
	assert_eq(rig.brain.task_state(routine.task_id), "RUNNING", "the routine resumes on its own")
	assert_eq(rig.executor.spaces(), [&"plaza", &"home"] as Array[StringName])
	assert_eq(rig.executor.owners(), [shelter.task_id, routine.task_id] as Array[String])
	rig.executor.arrive()
	rig.tick(210.0)
	assert_eq(rig.phase(), "sleep")
	assert_true(rig.actor.sleeping)
	rig.dispose()

func test_conversation_claims_are_owned_and_urgent_duties_refuse() -> void:
	var rig := Routine.Rig.new()
	assert_true(rig.brain.request_conversation("a"))
	assert_true(rig.brain.request_conversation("a"), "the same session may ask again")
	assert_false(rig.brain.request_conversation("b"))
	assert_false(rig.brain.request_conversation(""))
	rig.brain.finish_conversation("b")
	assert_eq(rig.brain.controller.claim_owner(&"conversation"), "session:a")
	rig.brain.finish_conversation("a")
	rig.brain.finish_conversation("a")
	assert_eq(rig.brain.controller.claim_owner(&"conversation"), "")
	assert_true(rig.start(_routine(rig, "work", "bakery", 900.0), 100.0))
	assert_true(rig.brain.request_conversation("c"))
	rig.brain.finish_conversation("c")
	assert_true(rig.start(_caution(rig, 500.0), 101.0))
	assert_false(rig.brain.request_conversation("d"), "caution refuses")
	assert_eq(rig.brain.controller.claim_owner(&"conversation"), "")
	rig.dispose()

func test_shelter_revokes_a_session_and_its_claims_survive_stale_releases() -> void:
	var rig := Routine.Rig.new()
	assert_true(rig.start(_routine(rig, "work", "bakery", 900.0), 100.0))
	assert_true(rig.brain.request_conversation("old"))
	var shelter := _shelter(rig, 300.0)
	assert_true(rig.start(shelter, 110.0))
	assert_eq(rig.brain.controller.claim_owner(&"conversation"), shelter.task_id)
	assert_eq(rig.brain.controller.claim_owner(&"locomotion"), shelter.task_id)
	rig.brain.finish_conversation("old")
	assert_eq(rig.brain.controller.claim_owner(&"conversation"), shelter.task_id)
	assert_false(rig.brain.request_conversation("new"))
	assert_false(rig.brain.request_task(_caution(rig, 400.0)), "weaker duty refused")
	assert_false(rig.brain.end_task("safety:holt_partner:stale"))
	assert_eq(rig.brain.controller.claim_owner(&"locomotion"), shelter.task_id)
	assert_eq(rig.brain.task_state(shelter.task_id), "RUNNING")
	rig.dispose()

func test_a_stale_travel_completion_cannot_finish_a_newer_task() -> void:
	var rig := Routine.Rig.new()
	var routine := _routine(rig, "work", "bakery", 900.0)
	assert_true(rig.start(routine, 100.0))
	var shelter := _shelter(rig, 300.0)
	assert_true(rig.start(shelter, 110.0))
	assert_eq(rig.brain.task_state(routine.task_id), "SUSPENDED")
	rig.executor.states[routine.task_id] = &"arrived"
	rig.tick(111.0)
	assert_eq(rig.brain.task_state(shelter.task_id), "RUNNING")
	assert_eq(rig.phase(), "flee")
	assert_eq(rig.brain.task_state(routine.task_id), "SUSPENDED")
	rig.executor.arrive()
	rig.tick(120.0)
	assert_eq(rig.phase(), "shelter")
	rig.tick(300.0)
	assert_eq(rig.last_finished()["task_id"], shelter.task_id)
	assert_eq(rig.last_finished()["reason"], &"until")
	assert_eq(rig.brain.task_state(routine.task_id), "RUNNING")
	rig.dispose()

func test_checkpoint_mid_travel_reissues_the_journey_under_the_same_owner() -> void:
	var rig := Routine.Rig.new()
	var routine := _routine(rig, "work", "bakery", 900.0)
	assert_true(rig.start(routine, 100.0))
	rig.tick(110.0)
	assert_true(rig.brain.save_checkpoint())
	var loaded := _reloaded(rig)
	loaded.actor.world_space = &"street"
	assert_true(loaded.brain.restore_checkpoint(130.0))
	assert_eq(loaded.brain.task_state(routine.task_id), "RUNNING")
	assert_eq(loaded.executor.owners(), [routine.task_id] as Array[String])
	assert_eq(loaded.executor.spaces(), [&"bakery"] as Array[StringName])
	assert_eq(loaded.phase(), "travel")
	loaded.executor.arrive()
	loaded.tick(140.0)
	assert_eq(loaded.phase(), "perform")
	var next := _shelter(loaded, 400.0)
	assert_true(loaded.brain.request_task(next))
	assert_ne(next.task_id, routine.task_id)
	rig.dispose()
	loaded.dispose()

func test_checkpoint_restores_a_running_duty_with_its_suspended_routine() -> void:
	var rig := Routine.Rig.new()
	var routine := _routine(rig, "work", "bakery", 900.0)
	var shelter := _shelter(rig, 300.0)
	assert_true(rig.start(routine, 100.0))
	assert_true(rig.start(shelter, 110.0))
	assert_true(rig.brain.save_checkpoint())
	var loaded := _reloaded(rig)
	assert_true(loaded.brain.restore_checkpoint(150.0))
	assert_eq(loaded.brain.task_state(shelter.task_id), "RUNNING")
	assert_eq(loaded.brain.task_state(routine.task_id), "SUSPENDED")
	assert_eq(loaded.brain.controller.claim_owner(&"locomotion"), shelter.task_id)
	assert_eq(loaded.executor.owners(), [shelter.task_id] as Array[String])
	loaded.tick(300.0)
	assert_eq(loaded.brain.task_state(routine.task_id), "RUNNING")
	var snapshot: Dictionary = loaded.brain.debug_snapshot()
	assert_eq(snapshot["current"]["task_id"], routine.task_id)
	rig.dispose()
	loaded.dispose()

func test_restoring_nothing_or_an_ended_task_leaves_the_brain_idle() -> void:
	var rig := Routine.Rig.new()
	assert_true(rig.brain.save_checkpoint(), "an idle brain saves an empty checkpoint")
	assert_true(rig.mind.task_checkpoint().is_empty())
	assert_true(rig.brain.restore_checkpoint(100.0))
	assert_true(rig.brain.current_activity().is_empty())
	var routine := _routine(rig, "work", "bakery", 200.0)
	assert_true(rig.start(routine, 100.0))
	assert_true(rig.brain.save_checkpoint())
	var late := _reloaded(rig)
	assert_false(late.brain.restore_checkpoint(500.0))
	assert_true(late.brain.current_activity().is_empty())
	assert_eq(late.last_finished()["task_id"], routine.task_id)
	assert_eq(late.last_finished()["reason"], &"restore_invalid")
	assert_true(late.executor.begun.is_empty())
	rig.dispose()
	late.dispose()

func test_death_cancels_everything_once_and_refuses_later_requests() -> void:
	var rig := Routine.Rig.new()
	var routine := _routine(rig, "work", "bakery", 900.0)
	var shelter := _shelter(rig, 300.0)
	assert_true(rig.start(routine, 100.0))
	assert_true(rig.start(shelter, 110.0))
	assert_true(rig.brain.request_conversation("x") == false)
	rig.actor.health = 0
	rig.tick(111.0)
	assert_eq(rig.finished.size(), 2)
	for entry: Dictionary in rig.finished:
		assert_eq(entry["status"], "CANCELLED")
		assert_eq(entry["reason"], &"death")
	assert_null(rig.brain.controller.current)
	assert_null(rig.brain.controller.suspended)
	assert_eq(rig.brain.controller.claim_owner(&"locomotion"), "")
	var cancels: int = rig.executor.cancelled.size()
	rig.tick(112.0)
	rig.brain.interrupt(NpcTask.Interrupt.DEATH)
	assert_eq(rig.finished.size(), 2)
	assert_eq(rig.executor.cancelled.size(), cancels)
	assert_false(rig.brain.request_task(_routine(rig, "work", "bakery", 900.0)))
	assert_false(rig.brain.request_conversation("late"))
	assert_false(rig.brain.end_task(shelter.task_id))
	assert_true(rig.brain.debug_snapshot()["dead"])
	rig.dispose()

func test_death_through_interrupt_ends_a_task_without_waiting_for_the_next_tick() -> void:
	var rig := Routine.Rig.new()
	assert_true(rig.start(_routine(rig, "work", "bakery", 900.0), 100.0))
	rig.brain.interrupt(NpcTask.Interrupt.DEATH)
	assert_eq(rig.last_finished()["reason"], &"death")
	assert_false(rig.brain.request_task(_routine(rig, "work", "bakery", 900.0)))
	rig.dispose()

func test_task_ids_ending_and_state_lookup() -> void:
	var rig := Routine.Rig.new()
	var first := _routine(rig, "work", "bakery", 900.0)
	assert_true(rig.start(first, 100.0))
	assert_true(first.task_id.begins_with("routine:holt_partner:"), first.task_id)
	var second := _caution(rig, 500.0)
	assert_true(rig.brain.request_task(second))
	assert_true(second.task_id.begins_with("safety:holt_partner:"), second.task_id)
	assert_ne(first.task_id, second.task_id)
	assert_eq(rig.brain.task_state(first.task_id), "SUSPENDED")
	assert_eq(rig.brain.task_state(second.task_id), "RUNNING")
	assert_eq(rig.brain.task_state("nope"), "")
	assert_false(rig.brain.end_task("nope"))
	assert_false(rig.brain.request_task(second), "an already running task cannot be requested again")
	assert_true(rig.brain.end_task(second.task_id))
	assert_eq(rig.last_finished()["reason"], &"released")
	assert_false(rig.brain.end_task(second.task_id), "ending twice is harmless")
	assert_eq(rig.brain.task_state(second.task_id), "")
	rig.tick(101.0)
	assert_eq(rig.brain.task_state(first.task_id), "RUNNING", "the displaced routine resumes")
	assert_true(rig.brain.end_task(first.task_id, &"owner_done"))
	assert_eq(rig.last_finished()["reason"], &"owner_done")
	assert_true(rig.brain.current_activity().is_empty())
	rig.dispose()

func test_invalid_or_weaker_requests_change_nothing() -> void:
	var rig := Routine.Rig.new()
	assert_false(rig.brain.request_task(null))
	var bad := Safety.safety_params("SHELTER", 300.0, "plaza", [10.0, 20.0])
	bad["response"] = "PANIC"
	assert_false(rig.brain.request_task(NpcSafetyTask.create(bad, rig.tuning)))
	assert_true(rig.start(_shelter(rig, 300.0), 100.0))
	assert_false(rig.brain.request_task(_caution(rig, 400.0)))
	assert_false(rig.brain.request_task(_routine(rig, "work", "bakery", 900.0)))
	assert_eq(rig.brain.current_activity()["kind"], "safety")
	rig.dispose()

func test_a_conversation_displaces_the_routine_and_is_not_saved() -> void:
	var rig := Routine.Rig.new()
	var routine := _routine(rig, "work", "bakery", 900.0)
	assert_true(rig.start(routine, 100.0))
	var talk := NpcSocialTask.create("s1", "holt_other", "initiator", rig.tuning)
	assert_true(rig.brain.request_task(talk))
	assert_eq(rig.phase(), "approach")
	assert_eq(rig.brain.current_activity()["activity"], "conversation")
	assert_eq(rig.executor.cancelled, [routine.task_id] as Array[String])
	rig.brain.interrupt(NpcTask.Interrupt.SCHEDULE)
	rig.tick(100.5)
	assert_eq(rig.brain.task_state(talk.task_id), "RUNNING")
	assert_true(rig.brain.save_checkpoint())
	var loaded := _reloaded(rig)
	assert_true(loaded.brain.restore_checkpoint(101.0), "the suspended routine survives")
	assert_eq(loaded.last_finished()["task_id"], talk.task_id)
	assert_eq(loaded.last_finished()["reason"], &"restore_invalid")
	assert_eq(loaded.brain.task_state(routine.task_id), "SUSPENDED")
	loaded.tick(102.0)
	assert_eq(loaded.brain.task_state(routine.task_id), "RUNNING")
	rig.brain.interrupt(NpcTask.Interrupt.HURT)
	assert_eq(rig.last_finished()["reason"], &"hurt")
	rig.tick(110.0)
	assert_eq(rig.brain.task_state(routine.task_id), "RUNNING", "the routine takes over after the conversation")
	rig.dispose()
	loaded.dispose()

func test_activity_and_debug_snapshot_describe_what_the_resident_is_doing() -> void:
	var rig := Routine.Rig.new()
	assert_true(rig.brain.current_activity().is_empty())
	var routine := _routine(rig, "work", "bakery", 900.0)
	assert_true(rig.start(routine, 100.0))
	var activity: Dictionary = rig.brain.current_activity()
	assert_eq(activity["task_id"], routine.task_id)
	assert_eq(activity["kind"], "routine")
	assert_eq(activity["phase"], "travel")
	assert_eq(activity["activity"], "work")
	assert_eq(activity["label"], "Heading to the bakery")
	assert_eq(activity["status"], "RUNNING")
	var shelter := _shelter(rig, 300.0)
	assert_true(rig.start(shelter, 110.0))
	assert_eq(rig.brain.current_activity()["activity"], "shelter")
	assert_eq(rig.brain.current_activity()["label"], "Taking cover")
	var snapshot: Dictionary = rig.brain.debug_snapshot()
	assert_eq(snapshot["npc_id"], "holt_partner")
	assert_false(snapshot["dead"])
	assert_eq(snapshot["current"]["task_id"], shelter.task_id)
	assert_eq(snapshot["suspended"]["task_id"], routine.task_id)
	assert_eq(snapshot["claims"]["locomotion"], shelter.task_id)
	assert_eq(snapshot["claims"]["conversation"], shelter.task_id)
	assert_false((snapshot["transitions"] as Array).is_empty())
	assert_true((snapshot["transitions"] as Array).size() <= NpcBrain.RECENT_TRANSITIONS)
	rig.dispose()

func test_only_terminal_transitions_are_announced() -> void:
	var rig := Routine.Rig.new()
	var routine := _routine(rig, "work", "bakery", 900.0)
	assert_true(rig.start(routine, 100.0))
	rig.brain.interrupt(NpcTask.Interrupt.HURT)
	assert_true(rig.finished.is_empty(), "suspension is not an ending")
	rig.tick(110.0)
	assert_true(rig.finished.is_empty(), "resuming is not an ending")
	rig.tick(900.0)
	assert_eq(rig.finished.size(), 1)
	rig.dispose()

class ServiceProbe extends NpcTask:
	var answer: Variant = null

	func _init() -> void:
		kind = &"probe"
		task_id = "probe:1"

	func _on_start(context: NpcTaskContext) -> NpcTaskResult:
		answer = context.call_service(&"town_note", ["body"])
		context.call_service(&"travel", [&"plaza", Vector2(1, 2), "Going", task_id])
		return NpcTaskResult.running()

func test_provided_services_reach_tasks_but_never_replace_the_brain_s_own() -> void:
	var rig := Routine.Rig.new()
	assert_false(rig.brain.provide_service(&"travel", func(_a, _b, _c, _d) -> bool: return false))
	assert_false(rig.brain.provide_service(&"", func(note: String) -> String: return note))
	assert_true(rig.brain.provide_service(&"town_note", func(_note: String) -> String: return "old"))
	assert_true(rig.brain.provide_service(&"town_note", func(note: String) -> String: return note))
	var probe := ServiceProbe.new()
	assert_true(rig.start(probe, 100.0))
	assert_eq(probe.answer, "body")
	assert_eq(rig.executor.owners(), ["probe:1"] as Array[String], "the brain still owns travel")
	rig.dispose()
